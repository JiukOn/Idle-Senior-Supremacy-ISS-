<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════
         DRACULA THEME — Dark Gothic & Burgundy / Crimson Palette
    ══════════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="ApplicationBackgroundColor">#150D11</Color>
    <Color x:Key="DraculaLayerColor">#1C1017</Color>
    <Color x:Key="DraculaCardColor">#25141E</Color>
    <Color x:Key="DraculaCardSecondaryColor">#301A27</Color>
    <Color x:Key="DraculaControlColor">#2C1824</Color>
    <Color x:Key="DraculaControlHoverColor">#3D2031</Color>
    <Color x:Key="DraculaBorderColor">#63223A</Color>
    <Color x:Key="DraculaPrimaryAccentColor">#C81E45</Color>
    <Color x:Key="DraculaSecondaryAccentColor">#E11D48</Color>
    <Color x:Key="DraculaTertiaryAccentColor">#9F1239</Color>
    <Color x:Key="DraculaTextPrimaryColor">#FDF2F5</Color>
    <Color x:Key="DraculaTextSecondaryColor">#E2B8C6</Color>
    <Color x:Key="DraculaTextTertiaryColor">#A87B8B</Color>

    <Color x:Key="SystemAccentColor">#C81E45</Color>
    <Color x:Key="SystemAccentColorPrimary">#C81E45</Color>
    <Color x:Key="SystemAccentColorSecondary">#E11D48</Color>
    <Color x:Key="SystemAccentColorTertiary">#9F1239</Color>

    <!-- Backgrounds & Layers -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource ApplicationBackgroundColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource ApplicationBackgroundColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="{StaticResource DraculaLayerColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource DraculaLayerColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource DraculaCardColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="{StaticResource DraculaCardSecondaryColor}"/>
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource DraculaLayerColor}"/>
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{StaticResource DraculaCardColor}"/>
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="{StaticResource DraculaLayerColor}"/>
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorSecondaryBrush" Color="{StaticResource DraculaCardColor}"/>

    <!-- Cards -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource DraculaCardColor}"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource DraculaCardSecondaryColor}"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource DraculaBorderColor}"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource DraculaBorderColor}"/>

    <!-- Controls & Inputs -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource DraculaControlColor}"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource DraculaControlHoverColor}"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource DraculaCardSecondaryColor}"/>
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#1F1018"/>
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="{StaticResource DraculaControlColor}"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource DraculaBorderColor}"/>
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#7D2948"/>
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="{StaticResource DraculaBorderColor}"/>
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource DraculaControlHoverColor}"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource DraculaCardSecondaryColor}"/>
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{StaticResource DraculaBorderColor}"/>
    <SolidColorBrush x:Key="LeftNavigationViewSeparatorBrush" Color="{StaticResource DraculaBorderColor}"/>

    <!-- Accents (Burgundy / Crimson) -->
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource DraculaPrimaryAccentColor}"/>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource DraculaPrimaryAccentColor}"/>
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource DraculaSecondaryAccentColor}"/>
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource DraculaTertiaryAccentColor}"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource DraculaPrimaryAccentColor}"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource DraculaSecondaryAccentColor}"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource DraculaTertiaryAccentColor}"/>
    <SolidColorBrush x:Key="ListViewItemPillFillBrush" Color="{StaticResource DraculaSecondaryAccentColor}"/>
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{StaticResource DraculaSecondaryAccentColor}"/>

    <!-- Typography -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource DraculaTextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource DraculaTextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource DraculaTextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextPlaceholderColorBrush" Color="{StaticResource DraculaTextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FFE4E9"/>

</ResourceDictionary>
