<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════
         MIDNIGHT THEME — Abyssal Dark & Electric Purple / Violet Palette
    ══════════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="ApplicationBackgroundColor">#090612</Color>
    <Color x:Key="MidnightLayerColor">#0F0A1E</Color>
    <Color x:Key="MidnightCardColor">#16102C</Color>
    <Color x:Key="MidnightCardSecondaryColor">#1F163D</Color>
    <Color x:Key="MidnightControlColor">#1D1438</Color>
    <Color x:Key="MidnightControlHoverColor">#2B1E52</Color>
    <Color x:Key="MidnightBorderColor">#452D82</Color>
    <Color x:Key="MidnightPrimaryAccentColor">#8B5CF6</Color>
    <Color x:Key="MidnightSecondaryAccentColor">#A855F7</Color>
    <Color x:Key="MidnightTertiaryAccentColor">#6D28D9</Color>
    <Color x:Key="MidnightTextPrimaryColor">#F3E8FF</Color>
    <Color x:Key="MidnightTextSecondaryColor">#C4B5FD</Color>
    <Color x:Key="MidnightTextTertiaryColor">#8B7BB8</Color>

    <Color x:Key="SystemAccentColor">#8B5CF6</Color>
    <Color x:Key="SystemAccentColorPrimary">#8B5CF6</Color>
    <Color x:Key="SystemAccentColorSecondary">#A855F7</Color>
    <Color x:Key="SystemAccentColorTertiary">#6D28D9</Color>

    <!-- Backgrounds & Layers -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource ApplicationBackgroundColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource ApplicationBackgroundColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="{StaticResource MidnightLayerColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource MidnightLayerColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource MidnightCardColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="{StaticResource MidnightCardSecondaryColor}"/>
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource MidnightLayerColor}"/>
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{StaticResource MidnightCardColor}"/>
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="{StaticResource MidnightLayerColor}"/>
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorSecondaryBrush" Color="{StaticResource MidnightCardColor}"/>

    <!-- Cards -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource MidnightCardColor}"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource MidnightCardSecondaryColor}"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource MidnightBorderColor}"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource MidnightBorderColor}"/>

    <!-- Controls & Inputs -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource MidnightControlColor}"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource MidnightControlHoverColor}"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource MidnightCardSecondaryColor}"/>
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#120C24"/>
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="{StaticResource MidnightControlColor}"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource MidnightBorderColor}"/>
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#5B3CA8"/>
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="{StaticResource MidnightBorderColor}"/>
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource MidnightControlHoverColor}"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource MidnightCardSecondaryColor}"/>
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{StaticResource MidnightBorderColor}"/>
    <SolidColorBrush x:Key="LeftNavigationViewSeparatorBrush" Color="{StaticResource MidnightBorderColor}"/>

    <!-- Accents (Electric Purple / Violet) -->
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource MidnightPrimaryAccentColor}"/>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource MidnightPrimaryAccentColor}"/>
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource MidnightSecondaryAccentColor}"/>
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource MidnightTertiaryAccentColor}"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource MidnightPrimaryAccentColor}"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource MidnightSecondaryAccentColor}"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource MidnightTertiaryAccentColor}"/>
    <SolidColorBrush x:Key="ListViewItemPillFillBrush" Color="{StaticResource MidnightSecondaryAccentColor}"/>
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{StaticResource MidnightSecondaryAccentColor}"/>

    <!-- Typography -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource MidnightTextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource MidnightTextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource MidnightTextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextPlaceholderColorBrush" Color="{StaticResource MidnightTextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#F3E8FF"/>

</ResourceDictionary>
