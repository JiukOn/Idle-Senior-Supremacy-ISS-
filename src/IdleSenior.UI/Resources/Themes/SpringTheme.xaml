<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════
         SPRING (PRIMAVERA) THEME — Warm Light Ivory & Solar Orange Palette
    ══════════════════════════════════════════════════════════════════════════ -->
    <Color x:Key="ApplicationBackgroundColor">#FFF8F1</Color>
    <Color x:Key="SpringLayerColor">#FFF2E4</Color>
    <Color x:Key="SpringCardColor">#FFFFFF</Color>
    <Color x:Key="SpringCardSecondaryColor">#FFEDD5</Color>
    <Color x:Key="SpringControlColor">#FFFFFF</Color>
    <Color x:Key="SpringControlHoverColor">#FFE4C4</Color>
    <Color x:Key="SpringBorderColor">#FDBA74</Color>
    <Color x:Key="SpringPrimaryAccentColor">#F97316</Color>
    <Color x:Key="SpringSecondaryAccentColor">#EA580C</Color>
    <Color x:Key="SpringTertiaryAccentColor">#C2410C</Color>
    <Color x:Key="SpringTextPrimaryColor">#27150B</Color>
    <Color x:Key="SpringTextSecondaryColor">#7C4324</Color>
    <Color x:Key="SpringTextTertiaryColor">#A86844</Color>

    <Color x:Key="SystemAccentColor">#F97316</Color>
    <Color x:Key="SystemAccentColorPrimary">#F97316</Color>
    <Color x:Key="SystemAccentColorSecondary">#EA580C</Color>
    <Color x:Key="SystemAccentColorTertiary">#C2410C</Color>

    <!-- Backgrounds & Layers -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource ApplicationBackgroundColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource ApplicationBackgroundColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="{StaticResource SpringLayerColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource SpringLayerColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource SpringCardColor}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="{StaticResource SpringCardSecondaryColor}"/>
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource SpringLayerColor}"/>
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{StaticResource SpringCardColor}"/>
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="{StaticResource SpringLayerColor}"/>
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorSecondaryBrush" Color="{StaticResource SpringCardColor}"/>

    <!-- Cards -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource SpringCardColor}"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource SpringCardSecondaryColor}"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource SpringBorderColor}"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource SpringBorderColor}"/>

    <!-- Controls & Inputs -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource SpringControlColor}"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource SpringControlHoverColor}"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource SpringCardSecondaryColor}"/>
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="{StaticResource SpringControlColor}"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource SpringBorderColor}"/>
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#FB923C"/>
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="{StaticResource SpringBorderColor}"/>
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource SpringControlHoverColor}"/>
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource SpringCardSecondaryColor}"/>
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{StaticResource SpringBorderColor}"/>
    <SolidColorBrush x:Key="LeftNavigationViewSeparatorBrush" Color="{StaticResource SpringBorderColor}"/>

    <!-- Accents (Solar Orange / Tangerine) -->
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource SpringPrimaryAccentColor}"/>
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource SpringPrimaryAccentColor}"/>
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource SpringSecondaryAccentColor}"/>
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource SpringTertiaryAccentColor}"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource SpringPrimaryAccentColor}"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource SpringSecondaryAccentColor}"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource SpringTertiaryAccentColor}"/>
    <SolidColorBrush x:Key="ListViewItemPillFillBrush" Color="{StaticResource SpringPrimaryAccentColor}"/>
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{StaticResource SpringPrimaryAccentColor}"/>

    <!-- Typography -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource SpringTextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource SpringTextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource SpringTextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextPlaceholderColorBrush" Color="{StaticResource SpringTextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FFF7ED"/>

</ResourceDictionary>
