<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════
         SPACING & CORNER RADII
    ══════════════════════════════════════════════════════════════════════════ -->
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="SmallCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="LargeCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">100</CornerRadius>

    <Thickness x:Key="PageMargin">28,24,28,24</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="SectionSpacing">0,0,0,24</Thickness>
    <Thickness x:Key="ItemSpacing">0,0,0,12</Thickness>

    <!-- ══════════════════════════════════════════════════════════════════════
         BASE CARD & TEXTBLOCK OVERRIDES
    ══════════════════════════════════════════════════════════════════════════ -->
    <Style TargetType="ui:TextBlock">
        <Setter Property="TextBlock.LineStackingStrategy" Value="MaxHeight"/>
        <Setter Property="TextBlock.LineHeight" Value="NaN"/>
    </Style>

    <Style TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
        <Setter Property="Padding" Value="20"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>

    <Style TargetType="ui:CardAction" BasedOn="{StaticResource {x:Type ui:CardAction}}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         GLASS CARD — subtle frosted look
    ══════════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="GlassCardStyle" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
        <Setter Property="Background" Value="#15FFFFFF"/>
        <Setter Property="BorderBrush" Value="#25FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         ACCENT BADGE — pill-shaped coloured label
    ══════════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="AccentBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColorBrush}"/>
        <Setter Property="CornerRadius" Value="100"/>
        <Setter Property="Padding" Value="12,4"/>
    </Style>

    <Style x:Key="SuccessBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#2250fa7b"/>
        <Setter Property="CornerRadius" Value="100"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <Style x:Key="WarningBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#33ffb86c"/>
        <Setter Property="CornerRadius" Value="100"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         SECTION HEADER — bold label above a card group
    ══════════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="SectionHeaderStyle" TargetType="ui:TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Appearance" Value="Secondary"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="TextBlock.LineStackingStrategy" Value="MaxHeight"/>
        <Setter Property="TextBlock.LineHeight" Value="NaN"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         PAGE TITLE / SUBTITLE CONVENIENCE STYLES
    ══════════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="PageTitleStyle" TargetType="ui:TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="TextBlock.LineStackingStrategy" Value="MaxHeight"/>
        <Setter Property="TextBlock.LineHeight" Value="NaN"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="ui:TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Appearance" Value="Secondary"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="TextBlock.LineStackingStrategy" Value="MaxHeight"/>
        <Setter Property="TextBlock.LineHeight" Value="NaN"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         GAME CARD — used in Library, Achievements, Dashboard carousel
    ══════════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="GameCardStyle" TargetType="ui:CardAction" BasedOn="{StaticResource {x:Type ui:CardAction}}">
        <Setter Property="Margin" Value="0,0,14,14"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="IsChevronVisible" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         QUEUE ROW separator
    ══════════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="QueueRowStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="20,12"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         PROGRESS BAR — thin accent strip
    ══════════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="ThinProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="#11FFFFFF"/>
        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorBrush}"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         LIST VIEW — transparent, borderless host container
    ══════════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="CleanListViewStyle" TargetType="ListView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0,0,10,0"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════════
         CUSTOM MODERN SCROLLBAR STYLES (Always Visible, High Contrast)
    ══════════════════════════════════════════════════════════════════════════ -->
    <Style x:Key="ModernScrollThumb" TargetType="{x:Type Thumb}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbBorder"
                            Background="#88FFFFFF"
                            CornerRadius="5"
                            Margin="1,0"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#DDFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource SystemAccentColorBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernHorizontalScrollThumb" TargetType="{x:Type Thumb}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="MinWidth" Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbBorder"
                            Background="#88FFFFFF"
                            CornerRadius="5"
                            Margin="0,1"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#DDFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource SystemAccentColorBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ModernVerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Width="12" Background="#10000000" SnapsToDevicePixels="True">
            <Border Background="#20FFFFFF" CornerRadius="6" Margin="1,2"/>
            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,2">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                  Focusable="False" Opacity="0"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ModernScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                  Focusable="False" Opacity="0"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="ModernHorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Height="12" Background="#10000000" SnapsToDevicePixels="True">
            <Border Background="#20FFFFFF" CornerRadius="6" Margin="2,1"/>
            <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2,1">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                  Focusable="False" Opacity="0"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ModernHorizontalScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                  Focusable="False" Opacity="0"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="12"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="Template" Value="{StaticResource ModernVerticalScrollBarTemplate}"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="Template" Value="{StaticResource ModernHorizontalScrollBarTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ui:DynamicScrollBar}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="12"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="Template" Value="{StaticResource ModernVerticalScrollBarTemplate}"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="Template" Value="{StaticResource ModernHorizontalScrollBarTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ScrollViewer}">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <Style TargetType="{x:Type ui:DynamicScrollViewer}">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

</ResourceDictionary>
