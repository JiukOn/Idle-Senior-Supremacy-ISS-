<Page x:Class="IdleSenior.UI.Views.Pages.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:helpers="clr-namespace:IdleSenior.UI.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="Library">

    <Grid Margin="{DynamicResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="{DynamicResource SectionSpacing}">
            <ui:TextBlock Text="{DynamicResource Library_Title}"
                          Style="{StaticResource PageTitleStyle}"/>
            <ui:TextBlock Text="{DynamicResource Library_Subtitle}"
                          Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <!-- ── Search and sort toolbar ──────────────────────────────────── -->
        <ui:Card Grid.Row="1" Margin="{DynamicResource SectionSpacing}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0"
                            x:Name="SearchBox"
                            PlaceholderText="{DynamicResource Library_SearchPlaceholder}"
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            TextChanged="SearchBox_TextChanged"
                            Margin="0,0,14,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:TextBlock Text="{DynamicResource Library_SortLabel}"
                                  VerticalAlignment="Center" Margin="0,0,10,0"
                                  Appearance="Secondary"/>
                    <ComboBox x:Name="SortByCombo" Width="182" SelectedIndex="0"
                              SelectionChanged="SortCombo_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource Library_Sort_Name}"   Tag="Name"/>
                        <ComboBoxItem Content="{DynamicResource Library_Sort_Playtime}" Tag="Playtime"/>
                        <ComboBoxItem Content="{DynamicResource Library_Sort_Recent}"  Tag="LastPlayed"/>
                        <ComboBoxItem Content="{DynamicResource Library_Sort_Completion}" Tag="Completion"/>
                        <ComboBoxItem Content="{DynamicResource Library_Sort_Release}" Tag="Release"/>
                    </ComboBox>
                    <ui:Button x:Name="SortDirectionButton"
                               Margin="10,0,0,0" Click="SortDirection_Click"
                               Appearance="Transparent">
                        <ui:SymbolIcon Symbol="ArrowSort24"/>
                    </ui:Button>
                    <Border Style="{StaticResource AccentBadgeStyle}" Margin="18,0,0,0">
                        <ui:TextBlock x:Name="GameCountText"
                                      Text="—" VerticalAlignment="Center"
                                      FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- ── Game grid (3 columns, larger cards & robust fallbacks) ───── -->
        <ScrollViewer x:Name="LibraryScrollViewer"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      helpers:ScrollBubbleHelper.EnableSmoothScroll="True">
            <ItemsControl x:Name="GamesGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardAction Style="{StaticResource GameCardStyle}"
                                       Click="GameCard_Click">
                            <Grid>
                                <!-- Fallback background with gamepad icon & title (always visible if image is missing/loading) -->
                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="12" Height="165">
                                    <Grid Margin="16,14,16,40">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Games24" FontSize="34"
                                                           Foreground="{DynamicResource SystemAccentColorBrush}"
                                                           Opacity="0.8" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <ui:TextBlock Text="{Binding Name}"
                                                          FontWeight="Bold" FontSize="13"
                                                          TextAlignment="Center"
                                                          TextWrapping="Wrap" MaxHeight="38"
                                                          TextTrimming="CharacterEllipsis"
                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Game Banner -->
                                <Border CornerRadius="12" ClipToBounds="True">
                                    <Image helpers:SmartImageLoader.FallbackUrls="{Binding BannerFallbackUrls}"
                                           helpers:SmartImageLoader.DecodeWidth="380"
                                           Height="165" Stretch="UniformToFill"/>
                                </Border>

                                <!-- Bottom overlay -->
                                <Border Background="#E60f081d"
                                        VerticalAlignment="Bottom"
                                        Padding="14,9"
                                        CornerRadius="0,0,12,12">
                                    <StackPanel VerticalAlignment="Center">
                                        <ui:TextBlock Text="{Binding Name}"
                                                      FontWeight="Bold" FontSize="13" Foreground="White"
                                                      TextWrapping="NoWrap"
                                                      TextTrimming="CharacterEllipsis"
                                                      Margin="0,0,0,3"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBlock Grid.Column="0" FontSize="11" Foreground="#CCFFFFFF"
                                                          TextTrimming="CharacterEllipsis" Margin="0,0,6,0">
                                                <Run Text="{Binding PlaytimeHours}"/>
                                                <Run Text="{DynamicResource Dash_PlaytimeSuffix}"/>
                                            </ui:TextBlock>
                                            <ui:TextBlock Grid.Column="1" Text="{Binding ReleaseYear}"
                                                          FontSize="11" Foreground="#99FFFFFF"
                                                          Visibility="{Binding ReleaseYear, Converter={StaticResource CountToVisibilityConverter}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ui:CardAction>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── Pagination Bar ────────────────────────────────────────────── -->
        <Border Grid.Row="3" Margin="0,14,0,0" Padding="8,10"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:Button x:Name="PrevPageBtn" Grid.Column="0"
                           Icon="{ui:SymbolIcon Symbol=ChevronLeft24}"
                           Content="Anterior"
                           Click="PrevPage_Click"
                           Appearance="Secondary" Padding="14,6"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:TextBlock x:Name="PageInfoText"
                                  Text="Página 1 de 1"
                                  FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>

                <ui:Button x:Name="NextPageBtn" Grid.Column="2"
                           Icon="{ui:SymbolIcon Symbol=ChevronRight24}"
                           Content="Próxima"
                           Click="NextPage_Click"
                           Appearance="Secondary" Padding="14,6"/>
            </Grid>
        </Border>

        <ui:ProgressRing x:Name="LoadingRing" Grid.Row="2"
                         IsIndeterminate="True" Visibility="Collapsed"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Page>
