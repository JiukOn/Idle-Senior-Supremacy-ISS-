<Page x:Class="IdleSenior.UI.Views.Pages.CardFarmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:helpers="clr-namespace:IdleSenior.UI.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="Card Farm">

    <Grid Margin="{DynamicResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="{DynamicResource SectionSpacing}">
            <ui:TextBlock Text="{DynamicResource CardFarm_Title}"
                          Style="{StaticResource PageTitleStyle}"/>
            <ui:TextBlock Text="{DynamicResource CardFarm_Subtitle}"
                          Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <!-- ── Current farming status card ─────────────────────────────── -->
        <ui:Card Grid.Row="1" Margin="{DynamicResource SectionSpacing}" Padding="22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Game banner — no broken placeholder URL -->
                <Border Grid.Column="0" CornerRadius="10" ClipToBounds="True"
                        Width="200" Height="94" Margin="0,0,22,0"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <Image x:Name="CurrentGameBanner" Stretch="UniformToFill">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <Trigger Property="Source" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ui:TextBlock x:Name="StatusTitle"
                                  Text="{DynamicResource CardFarm_StatusStopped}"
                                  FontSize="11" FontWeight="Black"
                                  TextWrapping="Wrap"
                                  Appearance="Secondary" Margin="0,0,0,4"/>
                    <ui:TextBlock x:Name="CurrentGameName"
                                  Text="{DynamicResource CardFarm_NoGame}"
                                  TextTrimming="CharacterEllipsis"
                                  FontSize="20" FontWeight="Bold"/>
                    <ProgressBar x:Name="FarmProgress"
                                 IsIndeterminate="True"
                                 Style="{StaticResource ThinProgressBarStyle}"
                                 Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <ui:TextBlock x:Name="CardValueText"
                                  Text="" FontSize="11" FontWeight="SemiBold"
                                  Foreground="#50fa7b" HorizontalAlignment="Right"
                                  Margin="0,0,0,2"/>
                    <ui:TextBlock x:Name="CardsRemainingText"
                                  Text="—" FontSize="12" FontWeight="Bold"
                                  Appearance="Secondary" HorizontalAlignment="Right"
                                  Margin="0,0,0,2"/>
                    <ui:TextBlock x:Name="TimeElapsedText"
                                  Text="00:00:00" FontSize="28" FontWeight="Black"
                                  HorizontalAlignment="Right"
                                  Foreground="{DynamicResource SystemAccentColorBrush}"/>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- ── Processing queue ─────────────────────────────────────────── -->
        <ui:Card Grid.Row="2" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        Padding="20,13" CornerRadius="12,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" Text="{DynamicResource CardFarm_QueueHeader}"
                                      Style="{StaticResource SectionHeaderStyle}"
                                      Margin="0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:TextBlock Text="Ordenar:" VerticalAlignment="Center" Margin="0,0,8,0" Appearance="Secondary" FontSize="11"/>
                            <ComboBox x:Name="CardSortCombo" Width="180" SelectedIndex="0"
                                      SelectionChanged="CardSortCombo_SelectionChanged"
                                      Margin="0,0,10,0">
                                <ComboBoxItem Content="Mais Cartas Restantes" Tag="Cards"/>
                                <ComboBoxItem Content="Maior Preço Mercado" Tag="Price"/>
                                <ComboBoxItem Content="Alfabética (A-Z)" Tag="Name"/>
                                <ComboBoxItem Content="Ano de Lançamento" Tag="Year"/>
                            </ComboBox>
                            <ui:Button x:Name="RefreshBtn"
                                       Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}"
                                       Click="Refresh_Click"
                                       Appearance="Transparent"
                                       ToolTip="{DynamicResource CardFarm_RefreshTooltip}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Disabled"
                              helpers:ScrollBubbleHelper.EnableSmoothScroll="True">
                    <Grid>
                        <!-- Notice when no cards or cookies missing -->
                        <StackPanel x:Name="EmptyNoticePanel"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="24,40">
                            <ui:SymbolIcon Symbol="Warning24" FontSize="36"
                                           Foreground="{DynamicResource SystemAccentColorBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <ui:TextBlock x:Name="EmptyNoticeTitle"
                                          Text="Nenhum drop de carta pendente encontrado"
                                          FontWeight="Bold" FontSize="16"
                                          HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <ui:TextBlock x:Name="EmptyNoticeDesc"
                                          Text="Para identificar cartas restantes, a Steam exige cookies de login (sessionid e steamLoginSecure). Configure-os na aba de Configurações."
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          FontSize="12" TextWrapping="Wrap" MaxWidth="500"
                                          TextAlignment="Center" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl x:Name="QueueList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource QueueRowStyle}"
                                            MouseLeftButtonUp="QueueRow_Click"
                                            Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="4" ClipToBounds="True"
                                                    Width="28" Height="28" Margin="0,0,14,0">
                                                <Image helpers:SmartImageLoader.FallbackUrls="{Binding IconFallbackUrls}"
                                                       helpers:SmartImageLoader.DecodeWidth="48"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <ui:TextBlock Text="{Binding Name}"
                                                              VerticalAlignment="Center"
                                                              TextTrimming="CharacterEllipsis"
                                                              FontWeight="SemiBold" FontSize="14"/>
                                                <ui:TextBlock Text="{Binding CardPriceText}"
                                                              FontSize="11" Appearance="Secondary"
                                                              Visibility="{Binding CardPriceText, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Border Background="#33FF5555" CornerRadius="4" Padding="6,2" Margin="0,0,10,0"
                                                        Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <ui:TextBlock Text="BLOQUEADO" FontSize="10" FontWeight="Bold" Foreground="#ff5555"/>
                                                </Border>
                                                <ui:TextBlock Text="{Binding RemainingCards}"
                                                              FontWeight="Bold"
                                                              Foreground="{DynamicResource SystemAccentColorBrush}"
                                                              Margin="0,0,5,0"/>
                                                <ui:TextBlock Text="{DynamicResource CardFarm_CardsLeft}"
                                                              Appearance="Secondary" FontSize="12"/>
                                            </StackPanel>
                                            <ui:Button Grid.Column="3"
                                                       Click="BlockGame_Click"
                                                       Tag="{Binding AppId}"
                                                       Appearance="Transparent"
                                                       Padding="6"
                                                       ToolTip="Bloquear / Desbloquear este jogo do farm">
                                                <ui:SymbolIcon Symbol="Prohibited24" FontSize="16" Foreground="#ff5555"/>
                                            </ui:Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>

                <ui:ProgressRing x:Name="LoadingRing" Grid.Row="1"
                                 IsIndeterminate="True" Visibility="Collapsed"
                                 Width="40" Height="40"/>
            </Grid>
        </ui:Card>

        <!-- ── Controls bar ─────────────────────────────────────────────── -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0"
                          Text="{DynamicResource CardFarm_Disclaimer}"
                          Appearance="Secondary" FontSize="12"
                          VerticalAlignment="Center" FontStyle="Italic"
                          TextWrapping="Wrap" Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Button x:Name="StopBtn"
                           Content="{DynamicResource CardFarm_Stop}"
                           Click="Stop_Click" IsEnabled="False"
                           Padding="24,12" Margin="0,0,10,0"/>
                <ui:Button x:Name="StartBtn"
                           Content="{DynamicResource CardFarm_Start}"
                           Appearance="Primary" Click="Start_Click"
                           Padding="28,12" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
