<Page x:Class="IdleSenior.UI.Views.Pages.AchievementEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:helpers="clr-namespace:IdleSenior.UI.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="760" d:DesignWidth="1050"
      Title="Achievement Editor">

    <Grid Margin="{DynamicResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Row 0: Header ────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0"
                       Icon="{ui:SymbolIcon Symbol=ArrowLeft24}"
                       Click="Back_Click"
                       Appearance="Transparent"
                       Margin="0,0,14,0" Padding="10"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                <ui:TextBlock x:Name="GameNameText"
                              Text="{DynamicResource AchEd_Loading}"
                              Style="{StaticResource PageTitleStyle}"
                              FontSize="24"/>
                <ui:TextBlock x:Name="AppIdText"
                              Text="AppID: ----"
                              Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>

            <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <ui:Button x:Name="CommunityGuidesBtn"
                           Content="{DynamicResource AchEd_GuidesBtn}"
                           Click="CommunityGuides_Click"
                           Icon="{ui:SymbolIcon Symbol=BookQuestionMark24}"
                           Appearance="Secondary"
                           Margin="0,2,8,2"/>
                <ui:Button Content="{DynamicResource AchEd_Invert}"
                           Click="Invert_Click"
                           Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                           Margin="0,2,8,2"/>
                <ui:Button Content="{DynamicResource AchEd_UnlockAll}"
                           Appearance="Secondary"
                           Click="UnlockAll_Click"
                           Icon="{ui:SymbolIcon Symbol=CheckmarkSquare24}"
                           Margin="0,2,8,2"/>
                <ui:Button Content="{DynamicResource AchEd_LockAll}"
                           Click="LockAll_Click"
                           Icon="{ui:SymbolIcon Symbol=DismissSquare24}"
                           Margin="0,2,8,2"/>
                <ui:Button Content="{DynamicResource AchEd_Save}"
                           Appearance="Primary"
                           Click="Save_Click"
                           Icon="{ui:SymbolIcon Symbol=Save24}"
                           Margin="0,2,0,2"
                           Padding="18,8"/>
            </WrapPanel>
        </Grid>

        <!-- ── Row 1: Organic Farm (Hours + Achievements Sync) ──────────── -->
        <ui:Card Grid.Row="1" Margin="0,0,0,16" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Row: Title, Community Completion Metrics & Live Countdown -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Timer24"
                                           Foreground="{DynamicResource SystemAccentColorBrush}"
                                           FontSize="16" Margin="0,0,8,0"/>
                            <ui:TextBlock Text="{DynamicResource AchEd_OrganicTitle}"
                                          FontSize="12" FontWeight="Black"
                                          TextWrapping="Wrap"
                                          Foreground="{DynamicResource SystemAccentColorBrush}"/>
                        </StackPanel>
                        <ui:TextBlock x:Name="OrganicMetricsText"
                                      Text="{DynamicResource AchEd_OrganicSubtitle}"
                                      Appearance="Secondary" FontSize="12"
                                      TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ui:TextBlock x:Name="OrganicElapsedText"
                                      Text="00:00:00"
                                      FontSize="20" FontWeight="Black"
                                      HorizontalAlignment="Right"
                                      Foreground="{DynamicResource SystemAccentColorBrush}"/>
                        <ui:TextBlock x:Name="OrganicNextText"
                                      Text="—"
                                      FontSize="11" FontWeight="SemiBold"
                                      Appearance="Secondary"
                                      MaxWidth="360"
                                      TextTrimming="CharacterEllipsis"
                                      HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <!-- Bottom Row: Pacing Controls & Action Buttons in a responsive Grid -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Margin="0,0,12,0">
                        <ui:TextBlock Text="{DynamicResource AchEd_PaceLabel}"
                                      VerticalAlignment="Center" Margin="0,2,8,2"
                                      Appearance="Secondary" FontSize="12" FontWeight="SemiBold"/>
                        <ComboBox x:Name="PacingCombo" Width="195" SelectedIndex="1"
                                  SelectionChanged="PacingCombo_SelectionChanged"
                                  Margin="0,2,8,2">
                            <ComboBoxItem Content="{DynamicResource AchEd_Pace_Fast}" Tag="Fastest"/>
                            <ComboBoxItem Content="{DynamicResource AchEd_Pace_Median}" Tag="Median"/>
                            <ComboBoxItem Content="{DynamicResource AchEd_Pace_Completionist}" Tag="Completionist"/>
                            <ComboBoxItem Content="{DynamicResource AchEd_Pace_Custom}" Tag="Custom"/>
                        </ComboBox>

                        <ui:TextBox x:Name="TargetHoursBox"
                                    Width="68" Text="6.0"
                                    KeyDown="TargetHoursBox_KeyDown"
                                    LostFocus="TargetHoursBox_LostFocus"
                                    ToolTip="Duração alvo total do cronograma (em horas)"
                                    Margin="0,2,5,2"/>
                        <ui:TextBlock Text="h" VerticalAlignment="Center"
                                      Appearance="Secondary" Margin="0,2,14,2"/>

                        <CheckBox x:Name="DiscountHoursCheck"
                                  Content="{DynamicResource AchEd_DiscountHours}"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Margin="0,2,0,2"
                                  Checked="DiscountHoursCheck_Changed"
                                  Unchecked="DiscountHoursCheck_Changed"/>
                    </WrapPanel>

                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <ui:Button x:Name="SimulateBtn"
                                   Content="{DynamicResource AchEd_SimulateBtn}"
                                   Icon="{ui:SymbolIcon Symbol=Sparkle24}"
                                   Click="SimulateSchedule_Click"
                                   Margin="0,2,6,2"/>
                        <ui:Button x:Name="UnlockNextBtn"
                                   Content="{DynamicResource AchEd_UnlockNextBtn}"
                                   Icon="{ui:SymbolIcon Symbol=FastForward24}"
                                   Click="UnlockNext_Click"
                                   IsEnabled="False"
                                   Margin="0,2,6,2"/>
                        <ui:Button x:Name="ResetScheduleBtn"
                                   Content="{DynamicResource AchEd_ResetScheduleBtn}"
                                   Icon="{ui:SymbolIcon Symbol=ArrowReset24}"
                                   Click="ResetSchedule_Click"
                                   Appearance="Transparent"
                                   Margin="0,2,6,2"/>
                        <ui:Button x:Name="StartPauseOrganicBtn"
                                   Content="{DynamicResource AchEd_StartOrganicBtn}"
                                   Icon="{ui:SymbolIcon Symbol=Play24}"
                                   Appearance="Primary"
                                   Click="StartPauseOrganic_Click"
                                   Margin="0,2,0,2"
                                   Padding="16,8"/>
                    </WrapPanel>
                </Grid>
            </Grid>
        </ui:Card>

        <!-- ── Row 2: Search, sort and counter ──────────────────────────── -->
        <ui:Card Grid.Row="2" Margin="0,0,0,16" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:TextBox x:Name="SearchBox"
                            PlaceholderText="{DynamicResource AchEd_FilterPlaceholder}"
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            TextChanged="SearchBox_TextChanged"
                            Margin="0,0,14,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:TextBlock Text="{DynamicResource AchEd_SortLabel}"
                                  VerticalAlignment="Center" Margin="0,0,10,0"
                                  Appearance="Secondary"/>
                    <ComboBox x:Name="SortByCombo" Width="210" SelectedIndex="0"
                              SelectionChanged="SortCombo_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource AchEd_Sort_Timeline}" Tag="Timeline"/>
                        <ComboBoxItem Content="{DynamicResource AchEd_Sort_Rarity}"   Tag="Rarity"/>
                        <ComboBoxItem Content="{DynamicResource AchEd_Sort_Alpha}"    Tag="Name"/>
                        <ComboBoxItem Content="{DynamicResource AchEd_Sort_Date}"     Tag="Date"/>
                        <ComboBoxItem Content="{DynamicResource AchEd_Sort_Status}"   Tag="Status"/>
                    </ComboBox>
                    <ui:Button x:Name="SortDirectionButton"
                               Margin="10,0,0,0" Click="SortDirection_Click"
                               Appearance="Transparent">
                        <ui:SymbolIcon Symbol="ArrowSort24"/>
                    </ui:Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="24,0,0,0">
                    <ui:TextBlock x:Name="StatsText"
                                  Text="0 / 0" VerticalAlignment="Center"
                                  FontSize="20" FontWeight="Bold" Margin="0,0,8,0"/>
                    <ui:TextBlock Text="{DynamicResource AchEd_Achieved}"
                                  VerticalAlignment="Center"
                                  Appearance="Secondary" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- ── Row 3: Achievement list ──────────────────────────────────── -->
        <ListView Grid.Row="3" x:Name="AchievementsList"
                  Style="{StaticResource CleanListViewStyle}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  helpers:ScrollBubbleHelper.EnableSmoothScroll="True"
                  d:ItemsSource="{d:SampleData ItemCount=8}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ui:Card Margin="{DynamicResource ItemSpacing}" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Checkbox -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsAchieved, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,16,0">
                                            <CheckBox.LayoutTransform>
                                                <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                            </CheckBox.LayoutTransform>
                                        </CheckBox>

                                        <!-- Achievement icon -->
                                        <Border Grid.Column="1"
                                                CornerRadius="8" ClipToBounds="True"
                                                Width="54" Height="54" Margin="0,0,16,0">
                                            <Image helpers:SmartImageLoader.FallbackUrls="{Binding IconFallbackUrls}"
                                                   helpers:SmartImageLoader.DecodeWidth="64"
                                                   Stretch="UniformToFill">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAchieved}" Value="False">
                                                                <Setter Property="Opacity" Value="0.45"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Border>

                                        <!-- Name, description & smart metadata badges -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <ui:TextBlock Text="{Binding Name}"
                                                          TextWrapping="Wrap"
                                                          FontWeight="Bold" FontSize="15"/>
                                            <ui:TextBlock Text="{Binding Description}"
                                                          Appearance="Secondary" FontSize="13"
                                                          TextWrapping="Wrap" Margin="0,2,0,6"/>

                                            <WrapPanel Orientation="Horizontal">
                                                <!-- Rarity & Points badge -->
                                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                        CornerRadius="4" Padding="7,3" Margin="0,2,8,2"
                                                        Visibility="{Binding RarityBadgeText, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <ui:TextBlock Text="{Binding RarityBadgeText}"
                                                                  FontSize="11" FontWeight="SemiBold"
                                                                  Appearance="Secondary"/>
                                                </Border>

                                                <!-- Prerequisite / Progression hint badge -->
                                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                        CornerRadius="4" Padding="7,3" Margin="0,2,8,2"
                                                        Visibility="{Binding PrerequisiteHint, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <ui:TextBlock Text="{Binding PrerequisiteHint}"
                                                                  FontSize="11" FontWeight="SemiBold"
                                                                  Foreground="{DynamicResource SystemAccentColorBrush}"/>
                                                </Border>

                                                <!-- Unobtainable warning badge -->
                                                <Border Background="#33FF5555"
                                                        CornerRadius="4" Padding="7,3" Margin="0,2,8,2"
                                                        Visibility="{Binding UnobtainableWarningText, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <ui:TextBlock Text="{Binding UnobtainableWarningText}"
                                                                  FontSize="11" FontWeight="Bold"
                                                                  Foreground="#ff5555"/>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Scheduled Timeline Badge OR Unlock Date -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                                    Margin="12,0,16,0" HorizontalAlignment="Right">
                                            <!-- Scheduled offset badge (for locked achievements in schedule) -->
                                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="6" Padding="10,5"
                                                    HorizontalAlignment="Right" Margin="0,0,0,4"
                                                    Visibility="{Binding ScheduleBadgeText, Converter={StaticResource StringToVisibilityConverter}}">
                                                <ui:TextBlock Text="{Binding ScheduleBadgeText}"
                                                              FontSize="12" FontWeight="Bold"
                                                              Foreground="#ffb86c"/>
                                            </Border>

                                            <!-- Unlock date (when achieved) -->
                                            <ui:TextBlock Text="{DynamicResource AchEd_UnlockedOn}"
                                                          FontSize="9" FontWeight="Black"
                                                          Appearance="Secondary"
                                                          HorizontalAlignment="Right"
                                                          Visibility="{Binding UnlockTime, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            <ui:TextBlock Text="{Binding UnlockTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                          FontSize="12" FontWeight="Bold"
                                                          HorizontalAlignment="Right"
                                                          Foreground="{DynamicResource SystemAccentColorBrush}"
                                                          Visibility="{Binding UnlockTime, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <!-- Achieved checkmark icon -->
                                        <ui:SymbolIcon Grid.Column="4"
                                                       Symbol="CheckmarkCircle24"
                                                       VerticalAlignment="Center"
                                                       Foreground="#50fa7b" FontSize="24"
                                                       Visibility="{Binding IsAchieved, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </ui:Card>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <ui:ProgressRing x:Name="LoadingRing" Grid.Row="3"
                         IsIndeterminate="True" Visibility="Collapsed"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Width="60" Height="60"/>

        <!-- ── Row 4: Pagination Bar ────────────────────────────────────── -->
        <Border Grid.Row="4" Margin="0,12,0,0" Padding="8,10"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:Button x:Name="PrevAchPageBtn" Grid.Column="0"
                           Icon="{ui:SymbolIcon Symbol=ChevronLeft24}"
                           Content="Anterior"
                           Click="PrevAchPage_Click"
                           Appearance="Secondary" Padding="14,6"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:TextBlock x:Name="AchPageInfoText"
                                  Text="Página 1 de 1"
                                  FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>

                <ui:Button x:Name="NextAchPageBtn" Grid.Column="2"
                           Icon="{ui:SymbolIcon Symbol=ChevronRight24}"
                           Content="Próxima"
                           Click="NextAchPage_Click"
                           Appearance="Secondary" Padding="14,6"/>
            </Grid>
        </Border>
    </Grid>
</Page>
