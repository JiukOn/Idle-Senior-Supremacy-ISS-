<Page x:Class="IdleSenior.UI.Views.Pages.AchievementsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:helpers="clr-namespace:IdleSenior.UI.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="680" d:DesignWidth="1000"
      Title="Achievements">

    <Grid Margin="{DynamicResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="{DynamicResource SectionSpacing}">
            <ui:TextBlock Text="{DynamicResource Ach_Title}"
                          Style="{StaticResource PageTitleStyle}"/>
            <ui:TextBlock Text="{DynamicResource Ach_Subtitle}"
                          Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>

        <!-- ── Search and sort toolbar ──────────────────────────────────── -->
        <ui:Card Grid.Row="1" Margin="{DynamicResource SectionSpacing}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0"
                            x:Name="SearchBox"
                            PlaceholderText="{DynamicResource Ach_SearchPlaceholder}"
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            TextChanged="SearchBox_TextChanged"
                            Margin="0,0,14,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:TextBlock Text="{DynamicResource Ach_SortLabel}"
                                  VerticalAlignment="Center" Margin="0,0,10,0"
                                  Appearance="Secondary"/>
                    <ComboBox x:Name="SortByCombo" Width="180" SelectedIndex="0"
                              SelectionChanged="SortCombo_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource Ach_Sort_Name}"       Tag="Name"/>
                        <ComboBoxItem Content="{DynamicResource Ach_Sort_Playtime}"   Tag="Playtime"/>
                        <ComboBoxItem Content="{DynamicResource Ach_Sort_Recent}"     Tag="LastPlayed"/>
                        <ComboBoxItem Content="{DynamicResource Ach_Sort_Completion}" Tag="Completion"/>
                    </ComboBox>
                    <ui:Button x:Name="SortDirectionButton"
                               Margin="10,0,0,0" Click="SortDirection_Click"
                               Appearance="Transparent">
                        <ui:SymbolIcon Symbol="ArrowSort24"/>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- ── Games grid (4 columns) ───────────────────────────────────── -->
        <ScrollViewer x:Name="AchievementsScrollViewer"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled"
                      helpers:ScrollBubbleHelper.EnableSmoothScroll="True">
            <ItemsControl x:Name="GamesGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardAction Style="{StaticResource GameCardStyle}"
                                       Click="GameCard_Click">
                            <StackPanel>
                                <Border CornerRadius="12,12,0,0" ClipToBounds="True">
                                    <Image helpers:SmartImageLoader.FallbackUrls="{Binding BannerFallbackUrls}"
                                           helpers:SmartImageLoader.DecodeWidth="260"
                                           Height="104" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Margin="12,10">
                                    <ui:TextBlock Text="{Binding Name}"
                                                  FontWeight="SemiBold" FontSize="13"
                                                  TextWrapping="NoWrap"
                                                  TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBlock Grid.Column="0" FontSize="11" FontWeight="SemiBold"
                                                      Appearance="Secondary" Margin="0,0,6,0">
                                            <Run Text="{Binding CompletionPercentage}"/>
                                            <Run Text="%"/>
                                        </ui:TextBlock>
                                        <ui:TextBlock Grid.Column="1" FontSize="11" Appearance="Secondary"
                                                      TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding AchievementCount}"/>
                                            <Run Text="{DynamicResource Ach_TotalSuffix}"/>
                                        </ui:TextBlock>
                                    </Grid>
                                    <ProgressBar Value="{Binding CompletionPercentage, Mode=OneWay}"
                                                 Minimum="0" Maximum="100"
                                                 Style="{StaticResource ThinProgressBarStyle}"
                                                 Margin="0,6,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ui:CardAction>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── Pagination Bar ────────────────────────────────────────────── -->
        <Border Grid.Row="3" Margin="0,14,0,0" Padding="8,10"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:Button x:Name="PrevPageBtn" Grid.Column="0"
                           Icon="{ui:SymbolIcon Symbol=ChevronLeft24}"
                           Content="Anterior"
                           Click="PrevPage_Click"
                           Appearance="Secondary" Padding="14,6"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:TextBlock x:Name="PageInfoText"
                                  Text="Página 1 de 1"
                                  FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>

                <ui:Button x:Name="NextPageBtn" Grid.Column="2"
                           Icon="{ui:SymbolIcon Symbol=ChevronRight24}"
                           Content="Próxima"
                           Click="NextPage_Click"
                           Appearance="Secondary" Padding="14,6"/>
            </Grid>
        </Border>

        <ui:ProgressRing x:Name="LoadingRing" Grid.Row="2"
                         IsIndeterminate="True" Visibility="Collapsed"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Page>
