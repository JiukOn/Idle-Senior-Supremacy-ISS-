<Page x:Class="IdleSenior.UI.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:helpers="clr-namespace:IdleSenior.UI.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="880" d:DesignWidth="1050"
      Title="Dashboard">

    <ScrollViewer x:Name="DashboardScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  helpers:ScrollBubbleHelper.EnableSmoothScroll="True">
        <Grid Margin="{DynamicResource PageMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Row 0: Header: Profile + Level XP + Actions ────────────── -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="68" Height="68" CornerRadius="34" ClipToBounds="True"
                            Background="#33bd93f9" Margin="0,0,16,0"
                            BorderBrush="#55ffffff" BorderThickness="2">
                        <Grid>
                            <ui:SymbolIcon Symbol="Person24" FontSize="32" Foreground="#88ffffff"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="AccountAvatarImg" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <!-- Name + Level + Integrity Badges -->
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,5">
                            <ui:TextBlock x:Name="AccountPersonaName" Text="Jogador Steam"
                                          FontSize="22" FontWeight="Bold" Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                            <Border x:Name="AccountLevelBadge" Background="#bd93f9" CornerRadius="8"
                                    Padding="8,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                <ui:TextBlock x:Name="AccountLevelText" Text="Nível 0"
                                              FontSize="11" FontWeight="Bold" Foreground="#11111b"/>
                            </Border>
                            <Border x:Name="VacStatusBadge" Background="#2250fa7b" CornerRadius="6"
                                    Padding="6,2" VerticalAlignment="Center" Margin="0,0,6,0">
                                <ui:TextBlock x:Name="VacStatusText" Text="🟢 VAC Limpo" FontSize="11" FontWeight="SemiBold" Foreground="#50fa7b"/>
                            </Border>
                            <Border x:Name="TradeStatusBadge" Background="#228be9fd" CornerRadius="6"
                                    Padding="6,2" VerticalAlignment="Center" Margin="0,0,6,0">
                                <ui:TextBlock x:Name="TradeStatusText" Text="🟢 Comércio Ativo" FontSize="11" FontWeight="SemiBold" Foreground="#8be9fd"/>
                            </Border>
                            <Border Background="#22bd93f9" CornerRadius="6"
                                    Padding="6,2" VerticalAlignment="Center">
                                <ui:TextBlock x:Name="AccountMemberSinceText" Text="📅 Desde Fev/2020" FontSize="11" FontWeight="SemiBold" Foreground="#bd93f9"/>
                            </Border>
                        </WrapPanel>

                        <!-- Level XP Progress Bar -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <ProgressBar x:Name="AccountXpProgressBar" Width="130" Height="4" Minimum="0" Maximum="500" Value="320"
                                         Style="{StaticResource ThinProgressBarStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ui:TextBlock x:Name="AccountXpText" Text="XP para próximo nível"
                                          FontSize="11" Appearance="Secondary" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Subtitle -->
                        <ui:TextBlock x:Name="AccountSubtitleText"
                                      Text="Carregando biblioteca e métricas..."
                                      Appearance="Secondary" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:Button Margin="0,0,10,0"
                               Icon="{ui:SymbolIcon Symbol=ArrowDownload24}"
                               Content="{DynamicResource Dash_SyncCovers}"
                               x:Name="SyncOfflineBtn"
                               Click="SyncOffline_Click"
                               Appearance="Primary" Padding="14,8"/>
                    <ui:Button Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}"
                               Content="{DynamicResource Dash_Refresh}"
                               x:Name="RefreshBtn"
                               Click="Refresh_Click"
                               Appearance="Secondary" Padding="14,8"/>
                </StackPanel>
            </Grid>

            <!-- ── Row 1: Sync Progress Card ──────────────────────────────── -->
            <ui:Card Grid.Row="1" x:Name="SyncProgressCard"
                     Margin="0,0,0,22" Padding="16" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock x:Name="SyncStatusText" Text="Sincronizando..."
                                      FontWeight="SemiBold" FontSize="13"/>
                        <ui:TextBlock x:Name="SyncPercentText" Grid.Column="1" Text="0%"
                                      Appearance="Secondary" FontSize="12"/>
                    </Grid>
                    <ProgressBar x:Name="SyncProgressBar" Height="6" Minimum="0" Maximum="100" Value="0"
                                 Style="{StaticResource ThinProgressBarStyle}"/>
                </StackPanel>
            </ui:Card>

            <!-- ── Row 2: Recently Played Carousel ────────────────────────── -->
            <StackPanel Grid.Row="2" Margin="0,0,0,24">
                <ui:TextBlock Text="{DynamicResource Dash_RecentGames}"
                              FontWeight="SemiBold" FontSize="17" Margin="0,0,0,14"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              helpers:ScrollBubbleHelper.HorizontalWheelScroll="True">
                    <ItemsControl x:Name="RecentGamesCarousel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:CardAction Style="{StaticResource GameCardStyle}"
                                               Width="240" Click="GameCard_Click">
                                    <Grid>
                                        <Border CornerRadius="12" ClipToBounds="True">
                                            <Image helpers:SmartImageLoader.FallbackUrls="{Binding BannerFallbackUrls}"
                                                   helpers:SmartImageLoader.DecodeWidth="280"
                                                   Height="134" Stretch="UniformToFill"/>
                                        </Border>
                                        <Border VerticalAlignment="Bottom" Height="64"
                                                CornerRadius="0,0,12,12">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="Transparent" Offset="0"/>
                                                    <GradientStop Color="#D9000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,10">
                                                <ui:TextBlock Text="{Binding Name}"
                                                              FontWeight="Bold" Foreground="White"
                                                              TextWrapping="NoWrap"
                                                              TextTrimming="CharacterEllipsis"/>
                                                <Grid>
                                                    <ui:TextBlock FontSize="10" Foreground="#BBFFFFFF"
                                                                  HorizontalAlignment="Left">
                                                        <Run Text="{Binding PlaytimeHours}"/>
                                                        <Run Text="{DynamicResource Dash_PlaytimeSuffix}"/>
                                                    </ui:TextBlock>
                                                    <ui:TextBlock Text="{Binding ReleaseYear}"
                                                                  FontSize="10" Foreground="#88FFFFFF"
                                                                  HorizontalAlignment="Right"
                                                                  Visibility="{Binding ReleaseYear, Converter={StaticResource CountToVisibilityConverter}}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </ui:CardAction>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- ── Row 3: Stats Grid (Library, Achievements, Value) ────────── -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Diagnóstico da Biblioteca -->
                <ui:Card Grid.Column="0" Margin="0,0,14,0" Padding="22">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Library24" FontSize="26"
                                               Foreground="{DynamicResource SystemAccentColorBrush}"
                                               Margin="0,0,10,0"/>
                                <ui:TextBlock Text="{DynamicResource Dash_LibraryDiagnosis}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Symbol=ChevronRight24}"
                                       Click="GoToLibrary_Click" Appearance="Transparent" Padding="4"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock x:Name="DiagnosisTotalGames" Text="0" FontSize="36" FontWeight="Black"/>
                                <ui:TextBlock Text="{DynamicResource Dash_PurchasedGames}" FontSize="11" Appearance="Secondary" FontWeight="SemiBold"/>
                            </StackPanel>
                            <ui:TextBlock Grid.Column="1" x:Name="DiagnosisTotalHours" Text="0h jogadas"
                                          FontSize="13" Appearance="Secondary" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                        </Grid>

                        <!-- Segmented visual bar -->
                        <Grid Height="8" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ColBarNever" Width="40*"/>
                                <ColumnDefinition x:Name="ColBarUnder5" Width="30*"/>
                                <ColumnDefinition x:Name="ColBarOver5" Width="30*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#44475a" CornerRadius="4,0,0,4" Margin="0,0,2,0" ToolTip="Nunca Tocados (0h)"/>
                            <Border Grid.Column="1" Background="#ffb86c" Margin="0,0,2,0" ToolTip="Experimentados (&lt; 5h)"/>
                            <Border Grid.Column="2" Background="#50fa7b" CornerRadius="0,4,4,0" ToolTip="Relevantes (5h+)"/>
                        </Grid>

                        <!-- Details Rows -->
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#44475a" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="{DynamicResource Dash_NeverPlayed}" FontSize="12" Appearance="Secondary"/>
                            </StackPanel>
                            <ui:TextBlock x:Name="DiagnosisNeverPlayedText" Text="0 (0%)" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#ffb86c" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="{DynamicResource Dash_Under5h}" FontSize="12" Appearance="Secondary"/>
                            </StackPanel>
                            <ui:TextBlock x:Name="DiagnosisUnder5hText" Text="0 (0%)" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#50fa7b" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ui:TextBlock Text="{DynamicResource Dash_Over5h}" FontSize="12" Appearance="Secondary"/>
                            </StackPanel>
                            <ui:TextBlock x:Name="DiagnosisOver5hText" Text="0 (0%)" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Card 2: Suas Conquistas -->
                <ui:Card Grid.Column="1" Margin="0,0,14,0" Padding="22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="Trophy24" FontSize="26" Foreground="#f1fa8c" Margin="0,0,10,0"/>
                            <ui:TextBlock Text="{DynamicResource Dash_YourAchievements}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock x:Name="AchUnlockedBig" Text="0" FontSize="36" FontWeight="Black"/>
                                <ui:TextBlock Text="{DynamicResource Dash_Unlocked}" FontSize="11" Appearance="Secondary" FontWeight="SemiBold"/>
                            </StackPanel>
                            <ui:TextBlock Grid.Column="1" x:Name="AchCompletionRateText" Text="0.0% conc."
                                          FontSize="13" Appearance="Secondary" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                        </Grid>

                        <ProgressBar x:Name="AchProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                     Margin="0,0,0,14" Style="{StaticResource ThinProgressBarStyle}"/>

                        <Grid Margin="0,0,0,8">
                            <ui:TextBlock Text="{DynamicResource Dash_PerfectGames}" FontSize="12" Appearance="Secondary"/>
                            <ui:TextBlock x:Name="AchPerfectGamesText" Text="0 platinas" FontSize="12" FontWeight="Bold"
                                          Foreground="#f1fa8c" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <ui:TextBlock Text="{DynamicResource Dash_UnlockedLabel}" FontSize="12" Appearance="Secondary"/>
                            <ui:TextBlock x:Name="AchUnlockedOfTotalText" Text="0" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <ui:TextBlock Text="{DynamicResource Dash_HunterPoints}" FontSize="12" Appearance="Secondary"/>
                            <ui:TextBlock x:Name="AchHunterPointsText" Text="0 pts" FontSize="12" FontWeight="Bold"
                                          Foreground="#8be9fd" HorizontalAlignment="Right"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,8,0,10"/>
                        <ui:TextBlock x:Name="AchCacheStatusText" Text="{DynamicResource Dash_AchievementsDisclaimer}"
                                      FontSize="10" Appearance="Secondary" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <ui:Button x:Name="SyncAchievementsBtn" Content="{DynamicResource Dash_SyncAchievements}"
                                   Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                                   Click="SyncAchievements_Click" Appearance="Secondary"
                                   HorizontalAlignment="Stretch" Padding="8,6"/>
                    </StackPanel>
                </ui:Card>

                <!-- Card 3: Valor da Biblioteca (R$) -->
                <ui:Card Grid.Column="2" Padding="22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="Tag24" FontSize="26" Foreground="#50fa7b" Margin="0,0,10,0"/>
                            <ui:TextBlock Text="{DynamicResource Dash_LibraryValue}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <ui:TextBlock x:Name="PriceStoreTotalText" Text="R$ —" FontSize="32" FontWeight="Black" Foreground="#50fa7b"/>
                                <ui:TextBlock Text="Preços de Hoje (Steam)" FontSize="11" Appearance="Secondary" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <ui:TextBlock Text="Valor Cheio (Sem Promoção)" FontSize="12" Appearance="Secondary"/>
                            <ui:TextBlock x:Name="PriceDiscountTotalText" Text="R$ —" FontSize="12" FontWeight="SemiBold"
                                          HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <ui:TextBlock Text="{DynamicResource Dash_AvgPerPaidGame}" FontSize="12" Appearance="Secondary"/>
                            <ui:TextBlock x:Name="PriceAverageText" Text="R$ —" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <ui:TextBlock Text="Preço Médio / Hora (Pagos)" FontSize="12" Appearance="Secondary"/>
                            <ui:TextBlock x:Name="PricePerHourText" Text="R$ —" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <ui:TextBlock Text="{DynamicResource Dash_PaidGamesAnalyzed}" FontSize="12" Appearance="Secondary"/>
                            <ui:TextBlock x:Name="PricePaidCountText" Text="—" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,8,0,10"/>
                        <ui:TextBlock x:Name="PriceCacheStatusText" Text="{DynamicResource Dash_StoreDisclaimer}"
                                      FontSize="10" Appearance="Secondary" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <ui:Button x:Name="CalcPricesBtn" Content="{DynamicResource Dash_SyncPrices}"
                                   Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                                   Click="SyncPrices_Click" Appearance="Secondary"
                                   HorizontalAlignment="Stretch" Padding="8,6"/>
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- ── Row 4: "O Que Jogar Hoje?" + "Atualizações da Steam" ──── -->
            <Grid Grid.Row="4" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- Card: O que Jogar Hoje? -->
                <ui:Card Grid.Column="0" Margin="0,0,14,0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Sparkle24" FontSize="22" Foreground="#ffb86c" Margin="0,0,8,0"/>
                                <ui:TextBlock Text="{DynamicResource Dash_WhatToPlay}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ui:Button HorizontalAlignment="Right"
                                       Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}"
                                       ToolTip="{DynamicResource Dash_RerollTooltip}"
                                       Appearance="Transparent" Padding="4"
                                       Click="RerollSuggestion_Click"/>
                        </Grid>

                        <!-- Game Banner + Details -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource ControlFillColorSecondaryBrush}" Width="110" Height="68" VerticalAlignment="Center">
                                <Image x:Name="SuggestedGameBanner" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <ui:TextBlock x:Name="SuggestedGameTitle" Text="Sorteando sugestão..."
                                              FontWeight="Bold" FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                <ui:TextBlock x:Name="SuggestedGameHours" Text="0.0h registradas"
                                              Appearance="Secondary" FontSize="11" Margin="0,3,0,0"/>
                                <ui:TextBlock x:Name="SuggestedGameYear" Text=""
                                              Appearance="Secondary" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Buttons -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:Button x:Name="ViewSuggestedGameBtn"
                                       Content="{DynamicResource Dash_ViewGame}" Icon="{ui:SymbolIcon Symbol=Eye24}"
                                       Click="ViewSuggestedGame_Click"
                                       Appearance="Primary" HorizontalAlignment="Stretch" Margin="0,0,8,0"/>
                            <ui:Button Grid.Column="1"
                                       Content="{DynamicResource Dash_RerollBtn}" Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                                       Click="RerollSuggestion_Click"
                                       Appearance="Secondary"/>
                        </Grid>
                    </Grid>
                </ui:Card>

                <!-- Card: Atualizações e Notícias dos Jogos -->
                <ui:Card Grid.Column="1" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="News24" FontSize="22" Foreground="#50fa7b" Margin="0,0,8,0"/>
                                <ui:TextBlock Text="{DynamicResource Dash_GameUpdates}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ui:TextBlock Text="{DynamicResource Dash_OfficialSteamNotes}" Appearance="Secondary" FontSize="11"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- News Items -->
                        <ItemsControl Grid.Row="1" x:Name="SteamNewsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="10,8" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="8"
                                            MouseLeftButtonUp="NewsItem_Click" Cursor="Hand" ToolTip="Clique para abrir no navegador">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <Border Background="#3350fa7b" CornerRadius="4" Padding="5,1" Margin="0,0,8,0">
                                                        <ui:TextBlock Text="{Binding GameName}" FontSize="10" FontWeight="Bold" Foreground="#50fa7b"/>
                                                    </Border>
                                                    <ui:TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                                                  TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                                </StackPanel>
                                                <ui:TextBlock Text="{Binding Contents}" FontSize="11" Appearance="Secondary"
                                                              TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                            </StackPanel>
                                            <ui:TextBlock Grid.Column="1" Text="{Binding DateFormatted}" FontSize="10"
                                                          Appearance="Secondary" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ui:Card>
            </Grid>

            <!-- ── Row 5: Curiosidade Gamer & Slot de Destaque / Promoção ─── -->
            <ui:Card Grid.Row="5" Margin="0,20,0,28" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="42" Height="42" CornerRadius="21" Background="#33f1fa8c" VerticalAlignment="Center" Margin="0,0,14,0">
                        <ui:SymbolIcon Symbol="Lightbulb24" FontSize="22" Foreground="#f1fa8c" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <ui:TextBlock Text="{DynamicResource Dash_TriviaTitle}" FontSize="11" FontWeight="Bold" Foreground="#f1fa8c" Margin="0,0,8,0"/>
                            <ui:TextBlock Text="{DynamicResource Dash_DidYouKnow}" FontSize="11" Appearance="Secondary"/>
                        </StackPanel>
                        <ui:TextBlock x:Name="GamerTriviaText"
                                      Text="Em 2003, a Steam foi lançada originalmente pela Valve apenas como um cliente de atualização obrigatório para o Counter-Strike 1.6."
                                      FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <ui:Button Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                                   Content="{DynamicResource Dash_NextFact}"
                                   Click="NextTrivia_Click"
                                   Appearance="Secondary" Padding="12,6"/>
                    </StackPanel>
                </Grid>
            </ui:Card>
        </Grid>
    </ScrollViewer>
</Page>
