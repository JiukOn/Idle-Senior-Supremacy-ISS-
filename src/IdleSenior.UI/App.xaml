<Application x:Class="IdleSenior.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IdleSenior.UI"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:IdleSenior.UI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Resources/Themes/ThemeResources.xaml" />
                <!-- Default language: swapped at runtime by LocalizationService -->
                <ResourceDictionary Source="Resources/Strings.pt-BR.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <conv:FarmingButtonConverter x:Key="FarmingButtonConverter"/>
            <conv:FarmingAppearanceConverter x:Key="FarmingAppearanceConverter"/>
            <conv:IdlingStatusConverter x:Key="IdlingStatusConverter"/>
            <conv:IdlingColorConverter x:Key="IdlingColorConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
